# BestVideo — Environment variables

# ----- Database -----
DATABASE_URL="postgresql://user:password@localhost:5432/text_to_video?schema=public"

# ----- Auth -----
# HMAC secret for signing the session cookie. MUST be set in production.
AUTH_SECRET="change-me-to-a-long-random-string"
# Cookie name (optional).
# AUTH_COOKIE_NAME=bv_session
# Enable POST /api/auth/dev-login in production (off by default).
# AUTH_DEV_LOGIN=true

# X-User-Id header still works for API testing / scripts.

# ----- Credits -----
# CREDITS_PER_VIDEO=10
# CREDITS_PER_IMAGE=5
# SIGNUP_CREDITS=50

# ----- Queue / Redis -----
# When set, BullMQ is used (queue, rate-limit, idempotency all upgrade to Redis).
# Without it, an in-process memory queue/cache is used (dev only).
REDIS_URL="redis://localhost:6379"
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# WORKER_CONCURRENCY=2

# ----- AI Video Provider -----
VIDEO_PROVIDER=replicate
REPLICATE_API_TOKEN="r8_..."
# REPLICATE_VIDEO_MODEL=stability-ai/stable-video-diffusion:...

# ----- AI Captioning (ZapCap) -----
# Free tier: sign up at https://zapcap.ai (3 free minutes, no card required),
# then copy the API key from the dashboard.
ZAPCAP_API_KEY="zapcap_..."
# Optional: pick a specific caption template (else the first available is used).
# Run `npm run demo:caption` to print available template ids.
# ZAPCAP_TEMPLATE_ID=
# Optional: override the API host.
# ZAPCAP_BASE_URL=https://api.zapcap.ai

# ----- B-roll images (Pexels) -----
# Used by "Add photos" to fetch high-quality stock photos matched to the
# transcript. Get a FREE key at https://www.pexels.com/api/ (instant, no card).
# Without it, the app falls back to keyless Openverse (lower quality).
PEXELS_API_KEY=""

# ----- AI Image Provider -----
# IMAGE_PROVIDER=replicate
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# ----- Prompt moderation (optional) -----
# OPENAI_API_KEY=sk-...

# ----- Storage (S3 or R2) -----
S3_BUCKET=my-videos
S3_REGION=auto
# For Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# Public URL for stored videos (e.g. CDN)
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# Re-upload provider output to our storage (set to "true" to enable)
# UPLOAD_VIDEO_TO_STORAGE=true
# UPLOAD_IMAGE_TO_STORAGE=true

# ----- Provider webhook (optional) -----
# HMAC secret for /api/webhook/video-ready
# VIDEO_WEBHOOK_SECRET=...

# ----- Stripe (credit purchases) -----
# When STRIPE_SECRET_KEY is set, /api/buy-credits creates a Checkout Session.
# When unset, the dev stub adds credits directly (disabled in prod unless
# ALLOW_STUB_BUY_CREDITS=true).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Cents per credit (default 5 → $0.05/credit, 100 credits = $5).
# STRIPE_PRICE_PER_CREDIT_CENTS=5
# ALLOW_STUB_BUY_CREDITS=
